#!/usr/bin/env bash
# CLI me-shell: install, update, restart, log, uninstall, dev.
# Dipasang ke ~/.local/bin/me-shell oleh "me-shell install".
set -euo pipefail

REPO_URL="https://github.com/Adomancer/me-shell"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/me-shell"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/me-shell"
QS_LINK="$CONF/quickshell/me-shell"
HYPR_DIR="$CONF/me-shell/hypr"
HYPR_CONF="$CONF/hypr/hyprland.conf"
SOURCE_LINE="source = $HYPR_DIR/me-shell.conf"
BIN="$HOME/.local/bin/me-shell"
KITTY_CONF="$CONF/kitty/kitty.conf"
# Penanda baris config lain yang dimatikan oleh installer, supaya bisa dikembalikan saat uninstall
MARK="#me-shell-off#"
# Program yang tugasnya diambil alih me-shell (bar, notifikasi, idle, agen polkit)
CLASH="waybar|swaync|mako|dunst|hyprpanel|ags|hypridle|hyprpolkitagent|polkit-gnome|polkit-kde"

YES=0

# --- Tampilan -----------------------------------------------------------------

if [ -t 1 ]; then
    A=$'\e[33m'; G=$'\e[32m'; R=$'\e[31m'; D=$'\e[2m'; B=$'\e[1m'; N=$'\e[0m'
else
    A=""; G=""; R=""; D=""; B=""; N=""
fi

step() { printf '\n%s>>%s %s%s%s\n' "$A" "$N" "$B" "$*" "$N"; }
ok() { printf '   %s[ok]%s %s\n' "$G" "$N" "$*"; }
note() { printf '   %s%s%s\n' "$D" "$*" "$N"; }
warn() { printf '   %s[!]%s %s\n' "$A" "$N" "$*"; }
die() { printf '%s[x]%s %s\n' "$R" "$N" "$*" >&2; exit 1; }

# Baca jawaban dari terminal, juga saat dijalankan lewat "curl | bash"
ask() {
    [ "$YES" = 1 ] && return 0
    local ans
    read -rp "   $1 [Y/n] " ans </dev/tty || ans=n
    [[ -z $ans || $ans == [yY]* ]]
}

banner() {
    printf '%s' "$A"
    cat <<'EOF'
 ███╗   ███╗███████╗      ███████╗██╗  ██╗███████╗██╗     ██╗
 ████╗ ████║██╔════╝      ██╔════╝██║  ██║██╔════╝██║     ██║
 ██╔████╔██║█████╗  █████╗███████╗███████║█████╗  ██║     ██║
 ██║╚██╔╝██║██╔══╝  ╚════╝╚════██║██╔══██║██╔══╝  ██║     ██║
 ██║ ╚═╝ ██║███████╗      ███████║██║  ██║███████╗███████╗███████╗
 ╚═╝     ╚═╝╚══════╝      ╚══════╝╚═╝  ╚═╝╚══════╝╚══════╝╚══════╝
EOF
    printf '%s' "$N"
}

# --- Lokasi repo --------------------------------------------------------------

# Pakai repo tempat script ini berada (mode development), kalau tidak ada pakai ~/.local/share/me-shell
repo_root() {
    local self dir
    self="$(readlink -f "${BASH_SOURCE[0]}")"
    dir="$(cd "$(dirname "$self")/.." && pwd)"
    if [ -f "$dir/shell.qml" ]; then echo "$dir"; else echo "$DATA"; fi
}

# --- Dependency ---------------------------------------------------------------

distro() {
    [ -r /etc/os-release ] || { echo unknown; return; }
    . /etc/os-release
    case "${ID:-} ${ID_LIKE:-}" in
    *arch*) echo arch ;;
    *fedora*) echo fedora ;;
    *) echo unknown ;;
    esac
}

have() { command -v "$1" >/dev/null; }

# Seperti ask, tapi default "tidak"; -y juga dianggap "tidak" (untuk hal besar yang harus dipilih sendiri)
ask_no() {
    [ "$YES" = 1 ] && return 1
    local ans
    read -rp "   $1 [y/N] " ans </dev/tty || ans=n
    [[ $ans == [yY]* ]]
}

# Nama AUR helper (paru/yay); tawarkan pasang yay-bin kalau belum ada. Gagal = tidak ada helper.
aur_helper() {
    have paru && { echo paru; return; }
    have yay && { echo yay; return; }
    ask "Tidak ada AUR helper. Pasang yay?" || return 1
    {
        sudo pacman -S --needed --noconfirm base-devel git
        local tmp
        tmp="$(mktemp -d)"
        git clone --depth 1 https://aur.archlinux.org/yay-bin.git "$tmp/yay-bin"
        (cd "$tmp/yay-bin" && makepkg -si --noconfirm)
        rm -rf "$tmp"
    } >&2
    have yay && echo yay
}

aur_install() {
    local helper
    helper="$(aur_helper)" || return 1
    "$helper" -S --needed --noconfirm "$@"
}

# Paket dari repo distro; paket yang tidak ada di Fedora dilewati, bukan menggagalkan semuanya
pkg_install() {
    case "$(distro)" in
    arch) sudo pacman -S --needed --noconfirm "$@" ;;
    fedora) sudo dnf install -y --skip-unavailable "$@" ;;
    *) return 1 ;;
    esac
}

# Tambah repo dari file .repo (dnf5 lalu dnf4), dilewati kalau sudah ada
dnf_repo() {
    [ -f "/etc/yum.repos.d/$(basename "$1")" ] && return
    sudo dnf config-manager addrepo --from-repofile="$1" 2>/dev/null || sudo dnf config-manager --add-repo "$1"
}

install_deps() {
    local d
    d="$(distro)"
    step "Dependency ($d)"
    case "$d" in
    arch)
        local pkgs=(hyprland xdg-desktop-portal-hyprland git curl brightnessctl networkmanager bluez-utils wl-clipboard cliphist grim wf-recorder hyprpicker hyprsunset cava tesseract tesseract-data-eng tesseract-data-ind ddcutil ttf-jetbrains-mono noto-fonts-emoji qt6-svg qt6-imageformats qt6-shadertools kitty starship)
        local aur=(quickshell matugen-bin)
        note "pacman: ${pkgs[*]}"
        note "AUR:    ${aur[*]}"
        ask "Install sekarang?" || { warn "Dependency dilewati"; return; }
        sudo pacman -S --needed --noconfirm "${pkgs[@]}"
        aur_install "${aur[@]}" || warn "Install manual dari AUR: ${aur[*]}"
        ;;
    fedora)
        local pkgs=(hyprland xdg-desktop-portal-hyprland matugen git curl quickshell brightnessctl NetworkManager bluez wl-clipboard cliphist grim wf-recorder hyprpicker hyprsunset cava tesseract tesseract-langpack-ind ddcutil jetbrains-mono-fonts google-noto-color-emoji-fonts qt6-qtsvg qt6-qtimageformats qt6-qtshadertools kitty)
        # Hyprland dan matugen tidak ada di repo resmi Fedora (cek: Fedora 44); diambil dari COPR.
        # sdegler/hyprland punya build untuk Fedora 43-45 + rawhide (juga hyprpicker dan hyprsunset),
        # lionheartp/Hyprland cadangannya.
        note "COPR:   errornointernet/quickshell, sdegler/hyprland, atim/starship"
        note "dnf:    ${pkgs[*]}"
        ask "Install sekarang?" || { warn "Dependency dilewati"; return; }
        sudo dnf install -y dnf-plugins-core
        sudo dnf copr enable -y errornointernet/quickshell ||
            die "COPR quickshell belum ada untuk Fedora ini. Coba lagi nanti atau build Quickshell dari source."
        local copr=""
        for c in sdegler/hyprland lionheartp/Hyprland; do
            if sudo dnf copr enable -y "$c"; then
                copr="$c"
                break
            fi
            warn "COPR $c tidak punya build untuk Fedora ini, coba yang lain"
        done
        [ -n "$copr" ] || die "Tidak ada COPR Hyprland untuk Fedora ini."
        # lionheartp tidak punya matugen; jangan sampai seluruh transaksi gagal karenanya
        sudo dnf install -y --skip-unavailable "${pkgs[@]}"
        command -v Hyprland >/dev/null || command -v hyprland >/dev/null || die "Hyprland gagal ter-install, cek pesan dnf di atas."
        command -v qs >/dev/null || die "Quickshell gagal ter-install, cek pesan dnf di atas."
        command -v matugen >/dev/null || note "matugen tidak ter-install; shell memakai warna amber bawaan"
        # starship tidak ada di repo resmi Fedora; prompt terminal opsional, jadi gagal pun lanjut
        if ! command -v starship >/dev/null; then
            { sudo dnf copr enable -y atim/starship && sudo dnf install -y starship; } ||
                warn "starship gagal di-install; terminal tetap jalan dengan prompt biasa"
        fi
        ;;
    *)
        warn "Distro tidak dikenal. Install manual: hyprland, quickshell, git, curl, brightnessctl, ddcutil,"
        warn "NetworkManager, bluez, wl-clipboard, cava, font JetBrains Mono, matugen,"
        warn "grim, wf-recorder, cliphist, hyprpicker, hyprsunset, tesseract (screenshot, rekam, clipboard, lampu malam, OCR)"
        ;;
    esac
    # ddcutil (brightness monitor eksternal lewat DDC/CI) butuh modul kernel i2c-dev
    if command -v ddcutil >/dev/null && [ ! -f /etc/modules-load.d/i2c-dev.conf ]; then
        echo i2c-dev | sudo tee /etc/modules-load.d/i2c-dev.conf >/dev/null && sudo modprobe i2c-dev &&
            ok "Modul i2c-dev aktif (brightness monitor eksternal)"
    fi
}

# Material Symbols (ikon), Doto (angka dot-matrix), Space Grotesk/Mono, dan Rubik tidak ada di repo resmi Fedora/Arch,
# jadi diunduh langsung dari repo font Google ke folder font user.
FONT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/fonts/me-shell"
FONTS=(
    "Material Symbols Rounded|MaterialSymbolsRounded.ttf|https://github.com/google/material-design-icons/raw/master/variablefont/MaterialSymbolsRounded%5BFILL%2CGRAD%2Copsz%2Cwght%5D.ttf"
    "Rubik|Rubik.ttf|https://github.com/google/fonts/raw/main/ofl/rubik/Rubik%5Bwght%5D.ttf"
    "Doto|Doto.ttf|https://github.com/google/fonts/raw/main/ofl/doto/Doto%5BROND%2Cwght%5D.ttf"
    "Space Grotesk|SpaceGrotesk.ttf|https://github.com/google/fonts/raw/main/ofl/spacegrotesk/SpaceGrotesk%5Bwght%5D.ttf"
    "Space Mono|SpaceMono-Regular.ttf|https://github.com/google/fonts/raw/main/ofl/spacemono/SpaceMono-Regular.ttf"
    "Space Mono Bold|SpaceMono-Bold.ttf|https://github.com/google/fonts/raw/main/ofl/spacemono/SpaceMono-Bold.ttf"
)

install_fonts() {
    step "Font ($FONT_DIR)"
    mkdir -p "$FONT_DIR"
    local entry name file url
    for entry in "${FONTS[@]}"; do
        IFS="|" read -r name file url <<<"$entry"
        if fc-list : family | tr ',' '\n' | grep -qxF "$name"; then
            ok "$name sudah ada"
        elif curl -fsSL -o "$FONT_DIR/$file" "$url"; then
            ok "$name diunduh"
        else
            warn "Gagal mengunduh $name; ikon/teks akan memakai font cadangan"
        fi
    done
    fc-cache -f "$FONT_DIR" >/dev/null 2>&1 || true
}

# --- Paket dev (opsional) -----------------------------------------------------

DEV_GROUPS=(base vscode python node php go java docker podman db apps)

# "Judul|paket yang ditampilkan" per grup dan distro
dev_info() {
    local d="$1" g="$2"
    case "$g:$d" in
    base:fedora) echo "Dasar & CLI|git gh git-lfs make gcc gcc-c++ ripgrep fd-find fzf bat eza jq btop neovim tmux zoxide httpie lazygit (COPR)" ;;
    base:arch) echo "Dasar & CLI|git github-cli git-lfs base-devel ripgrep fd fzf bat eza jq btop neovim tmux zoxide httpie lazygit" ;;
    vscode:fedora) echo "VS Code|code (repo resmi Microsoft)" ;;
    vscode:arch) echo "VS Code|visual-studio-code-bin (AUR)" ;;
    python:fedora) echo "Python|python3 python3-pip python3-devel pipx uv" ;;
    python:arch) echo "Python|python python-pip python-pipx uv" ;;
    node:*) echo "Node.js|nodejs npm + corepack (pnpm/yarn) di ~/.local/bin" ;;
    php:fedora) echo "PHP|php-cli php-fpm php-mbstring php-xml php-pdo php-mysqlnd php-pgsql php-gd php-zip php-intl php-bcmath php-opcache composer" ;;
    php:arch) echo "PHP|php php-fpm php-gd php-intl php-pgsql php-sqlite composer (+ ekstensi diaktifkan di php.ini)" ;;
    go:fedora) echo "Go|golang" ;;
    go:arch) echo "Go|go" ;;
    java:fedora) echo "Java|java-21-openjdk-devel maven" ;;
    java:arch) echo "Java|jdk21-openjdk maven" ;;
    docker:fedora) echo "Docker|docker-ce + compose + buildx (repo resmi Docker), grup docker" ;;
    docker:arch) echo "Docker|docker docker-compose docker-buildx, grup docker" ;;
    podman:*) echo "Podman|podman podman-compose" ;;
    db:fedora) echo "Database|mariadb-server postgresql-server valkey (service tidak dinyalakan otomatis)" ;;
    db:arch) echo "Database|mariadb postgresql valkey (service tidak dinyalakan otomatis)" ;;
    apps:fedora) echo "Aplikasi|brave-browser (repo resmi Brave), Discord (Flatpak dari Flathub)" ;;
    apps:arch) echo "Aplikasi|brave-bin (AUR), discord" ;;
    esac
}

dev_base() {
    if [ "$1" = fedora ]; then
        pkg_install git gh git-lfs make gcc gcc-c++ ripgrep fd-find fzf bat eza jq btop neovim tmux zoxide httpie
        have lazygit || { sudo dnf copr enable -y atim/lazygit && sudo dnf install -y lazygit; } || warn "lazygit dilewati"
    else
        pkg_install git github-cli git-lfs base-devel ripgrep fd fzf bat eza jq btop neovim tmux zoxide httpie lazygit
    fi
}

dev_vscode() {
    have code && return
    if [ "$1" = fedora ]; then
        sudo rpm --import https://packages.microsoft.com/keys/microsoft.asc
        printf '%s\n' "[code]" "name=Visual Studio Code" "baseurl=https://packages.microsoft.com/yumrepos/vscode" \
            "enabled=1" "autorefresh=1" "type=rpm-md" "gpgcheck=1" "gpgkey=https://packages.microsoft.com/keys/microsoft.asc" |
            sudo tee /etc/yum.repos.d/vscode.repo >/dev/null
        sudo dnf install -y code
    else
        aur_install visual-studio-code-bin
    fi
}

dev_python() {
    if [ "$1" = fedora ]; then
        pkg_install python3 python3-pip python3-devel pipx uv
    else
        pkg_install python python-pip python-pipx uv
    fi
}

# Corepack (pnpm/yarn) dipasang di ~/.local supaya tidak perlu sudo untuk npm global
dev_node() {
    pkg_install nodejs npm
    have corepack || npm install -g --prefix "$HOME/.local" corepack
    "$HOME/.local/bin/corepack" enable --install-directory "$HOME/.local/bin" 2>/dev/null ||
        corepack enable --install-directory "$HOME/.local/bin"
}

dev_php() {
    if [ "$1" = fedora ]; then
        pkg_install php-cli php-fpm php-mbstring php-xml php-pdo php-mysqlnd php-pgsql php-gd php-zip php-intl php-bcmath php-opcache composer
    else
        pkg_install php php-fpm php-gd php-intl php-pgsql php-sqlite composer
        # Di Arch ekstensi bawaan dimatikan di php.ini; nyalakan yang umum dipakai framework
        local ini=/etc/php/php.ini
        [ -f "$ini.me-shell.bak" ] || sudo cp "$ini" "$ini.me-shell.bak"
        sudo sed -i -E 's/^;(extension=(bcmath|gd|iconv|intl|mysqli|pdo_mysql|pdo_pgsql|pdo_sqlite|pgsql|sqlite3|zip))$/\1/' "$ini"
    fi
}

dev_go() {
    if [ "$1" = fedora ]; then pkg_install golang; else pkg_install go; fi
}

dev_java() {
    if [ "$1" = fedora ]; then pkg_install java-21-openjdk-devel maven; else pkg_install jdk21-openjdk maven; fi
}

dev_docker() {
    if [ "$1" = fedora ]; then
        if ! have docker; then
            # Repo Docker kadang belum punya build untuk Fedora terbaru; moby-engine dari Fedora jadi cadangan
            { dnf_repo https://download.docker.com/linux/fedora/docker-ce.repo &&
                sudo dnf install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin; } ||
                { warn "Repo Docker gagal, pakai moby-engine dari Fedora"; sudo dnf install -y moby-engine docker-compose; }
        fi
    else
        pkg_install docker docker-compose docker-buildx
    fi
    sudo systemctl enable --now docker
    if ! id -nG "$USER" | grep -qw docker; then
        sudo usermod -aG docker "$USER"
        note "Logout lalu login lagi supaya docker bisa dipakai tanpa sudo"
    fi
}

# podman-docker sengaja tidak dipasang: bentrok dengan docker-ce
dev_podman() {
    pkg_install podman podman-compose
}

dev_db() {
    if [ "$1" = fedora ]; then
        pkg_install mariadb-server postgresql-server valkey
        sudo test -d /var/lib/pgsql/data/base || sudo postgresql-setup --initdb
    else
        pkg_install mariadb postgresql valkey
        sudo test -d /var/lib/mysql/mysql || sudo mariadb-install-db --user=mysql --basedir=/usr --datadir=/var/lib/mysql
        sudo test -f /var/lib/postgres/data/PG_VERSION || sudo -u postgres initdb -D /var/lib/postgres/data
    fi
    note "Nyalakan saat perlu: sudo systemctl enable --now mariadb postgresql valkey"
}

dev_apps() {
    if [ "$1" = fedora ]; then
        have brave-browser || { dnf_repo https://brave-browser-rpm-release.s3.brave.com/brave-browser.repo && sudo dnf install -y brave-browser; }
        pkg_install flatpak
        flatpak --user remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
        flatpak --user install -y --noninteractive flathub com.discordapp.Discord
    else
        have brave || aur_install brave-bin
        pkg_install discord
    fi
}

cmd_dev() {
    local d g info title pkgs
    d="$(distro)"
    [ "$d" = unknown ] && die "Paket dev hanya untuk Fedora dan Arch."
    local done_=() skipped=() failed=()
    for g in "${DEV_GROUPS[@]}"; do
        info="$(dev_info "$d" "$g")"
        title="${info%%|*}"
        pkgs="${info#*|}"
        step "Paket dev: $title"
        note "$pkgs"
        if ! ask "Install?"; then
            skipped+=("$title")
            continue
        fi
        # Subshell + set -e: satu grup gagal tidak menghentikan grup lain. Bukan di dalam `if`, karena di sana
        # bash mengabaikan set -e dan grup yang gagal di tengah bisa tercatat berhasil.
        local rc=0
        set +e
        (set -e; "dev_$g" "$d")
        rc=$?
        set -e
        if [ "$rc" = 0 ]; then
            ok "$title"
            done_+=("$title")
        else
            warn "$title gagal, lihat pesan di atas"
            failed+=("$title")
        fi
    done
    step "Ringkasan paket dev"
    [ ${#done_[@]} -gt 0 ] && ok "Terpasang: ${done_[*]}"
    [ ${#skipped[@]} -gt 0 ] && note "Dilewati: ${skipped[*]}"
    [ ${#failed[@]} -gt 0 ] && warn "Gagal: ${failed[*]}"
    true
}

# --- File config --------------------------------------------------------------

link() {
    local target="$1" path="$2"
    mkdir -p "$(dirname "$path")"
    if [ -e "$path" ] && [ ! -L "$path" ]; then
        mv "$path" "$path.bak.$(date +%Y%m%d%H%M%S)"
        warn "$path sudah ada, dipindah ke .bak"
    fi
    ln -sfn "$target" "$path"
    ok "$path -> $target"
}

# Isi awal; shell menulis ulang file-file ini setiap start (services/Keybinds.qml)
write_hypr_files() {
    step "File Hyprland ($HYPR_DIR)"
    mkdir -p "$HYPR_DIR"
    if [ ! -f "$HYPR_DIR/me-shell.conf" ]; then
        cat >"$HYPR_DIR/me-shell.conf" <<EOF
# Dibuat oleh me-shell, ditulis ulang setiap shell start. Tambahkan di hyprland.conf:
#   $SOURCE_LINE

exec-once = qs -c me-shell

# Aplikasi Electron/Chromium (VS Code, Discord, Brave) jalan native di Wayland, tidak buram lewat XWayland
env = ELECTRON_OZONE_PLATFORM_HINT,auto

misc {
    allow_session_lock_restore = true
}

source = $HYPR_DIR/keybinds.conf
source = $HYPR_DIR/user.conf
EOF
    fi
    [ -f "$HYPR_DIR/keybinds.conf" ] || echo "# Diisi otomatis oleh me-shell saat start" >"$HYPR_DIR/keybinds.conf"
    [ -f "$HYPR_DIR/user.conf" ] || echo "# Keybind dan setting Hyprland milikmu sendiri. me-shell tidak pernah menimpa file ini." >"$HYPR_DIR/user.conf"
    ok "me-shell.conf, keybinds.conf, user.conf"
}

# Config minimal untuk yang belum punya hyprland.conf
minimal_hyprland_conf() {
    local term=kitty
    for t in kitty foot alacritty wezterm ghostty; do
        command -v "$t" >/dev/null && { term="$t"; break; }
    done
    cat <<EOF
# Config Hyprland minimal dari me-shell. Bebas diubah.
monitor = , preferred, auto, 1

\$terminal = $term
\$mainMod = SUPER

input {
    kb_layout = us
    follow_mouse = 1
}

general {
    gaps_in = 4
    gaps_out = 8
    border_size = 2
    layout = dwindle
}

decoration {
    rounding = 4
}

bind = \$mainMod, Return, exec, \$terminal
bind = \$mainMod, Q, killactive
bind = \$mainMod SHIFT, M, exit
bind = \$mainMod, V, togglefloating
bind = \$mainMod, F, fullscreen
bind = \$mainMod, left, movefocus, l
bind = \$mainMod, right, movefocus, r
bind = \$mainMod, up, movefocus, u
bind = \$mainMod, down, movefocus, d
EOF
    for i in 1 2 3 4 5 6 7 8 9; do
        echo "bind = \$mainMod, $i, workspace, $i"
        echo "bind = \$mainMod SHIFT, $i, movetoworkspace, $i"
    done
    cat <<EOF
bindm = \$mainMod, mouse:272, movewindow
bindm = \$mainMod, mouse:273, resizewindow

$SOURCE_LINE
EOF
}

setup_hyprland_conf() {
    step "Hyprland ($HYPR_CONF)"
    if [ -f "$CONF/hypr/hyprland.lua" ] && [ ! -f "$HYPR_CONF" ]; then
        warn "Config Hyprland-mu pakai Lua (hyprland.lua). Tambahkan sendiri source ke:"
        warn "  $HYPR_DIR/me-shell.conf"
        return
    fi
    if [ ! -f "$HYPR_CONF" ]; then
        mkdir -p "$(dirname "$HYPR_CONF")"
        minimal_hyprland_conf >"$HYPR_CONF"
        ok "Belum ada config, dibuatkan yang minimal"
        return
    fi
    if grep -qxF "$SOURCE_LINE" "$HYPR_CONF"; then
        ok "Baris source sudah ada"
    else
        cp "$HYPR_CONF" "$HYPR_CONF.me-shell.bak"
        printf '\n# me-shell\n%s\n' "$SOURCE_LINE" >>"$HYPR_CONF"
        ok "Baris source ditambahkan (backup: hyprland.conf.me-shell.bak)"
    fi

    # Bar/notif lain bentrok dengan me-shell; cari di semua file config Hyprland
    local hits
    hits="$(grep -rnE --include='*.conf' "^[[:space:]]*exec(-once)?[[:space:]]*=.*\b($CLASH)\b" "$CONF/hypr" 2>/dev/null | grep -v "$MARK" || true)"
    if [ -n "$hits" ]; then
        warn "Ditemukan program yang bentrok dengan me-shell:"
        printf '%s\n' "$hits" | sed 's/^/      /'
        if ask "Matikan baris-baris itu? (bisa dikembalikan lewat 'me-shell uninstall')"; then
            printf '%s\n' "$hits" | cut -d: -f1 | sort -u | while read -r f; do
                sed -i -E "s/^([[:space:]]*exec(-once)?[[:space:]]*=.*\b($CLASH)\b.*)$/$MARK \1/" "$f"
            done
            ok "Dimatikan"
        fi
    fi
}

# --- Terminal -----------------------------------------------------------------

# Gaya kitty + prompt starship, dipasang otomatis. Warna digenerate gen-colors.sh ke $STATE
# (kitty-colors.conf, starship.toml); tanpa wallpaper dipakai warna amber bawaan.
setup_terminal() {
    local root="$1" inc rc line wall
    inc="include $root/assets/kitty/me-shell.conf"
    step "Terminal"

    if [ ! -f "$STATE/kitty-colors.conf" ] || [ ! -f "$STATE/starship.toml" ]; then
        wall="$(sed -n 's/.*"path": *"\([^"]*\)".*/\1/p' "$STATE/wallpaper.json" 2>/dev/null || true)"
        [ -f "$wall" ] || wall="#f8bb71"
        if sh "$root/scripts/gen-colors.sh" "$wall" dark >/dev/null 2>&1; then
            ok "Warna terminal dibuat"
        else
            warn "Warna terminal gagal dibuat (matugen?); kitty memakai warna bawaannya"
        fi
    fi

    if command -v kitty >/dev/null; then
        if [ -f "$KITTY_CONF" ] && grep -qxF "$inc" "$KITTY_CONF"; then
            ok "kitty sudah memakai gaya me-shell"
        else
            mkdir -p "$(dirname "$KITTY_CONF")"
            [ -f "$KITTY_CONF" ] && cp "$KITTY_CONF" "$KITTY_CONF.me-shell.bak"
            printf '\n# me-shell\n%s\n' "$inc" >>"$KITTY_CONF"
            ok "kitty memakai gaya me-shell (backup: kitty.conf.me-shell.bak)"
        fi
    else
        warn "kitty tidak ter-install, gaya terminal dilewati"
    fi

    if ! command -v starship >/dev/null; then
        warn "starship tidak ter-install, prompt tetap bawaan shell"
        return 0
    fi
    case "$(basename "${SHELL:-bash}")" in
    bash) rc="$HOME/.bashrc" line='eval "$(starship init bash)"' ;;
    zsh) rc="${ZDOTDIR:-$HOME}/.zshrc" line='eval "$(starship init zsh)"' ;;
    fish) rc="$CONF/fish/config.fish" line='starship init fish | source' ;;
    *) return 0 ;;
    esac
    if grep -qF "starship init" "$rc" 2>/dev/null; then
        ok "starship sudah aktif di $rc"
    else
        mkdir -p "$(dirname "$rc")"
        printf '\n# me-shell\n%s\n' "$line" >>"$rc"
        ok "starship ditambahkan ke $rc"
    fi
}

# --- Shell --------------------------------------------------------------------

in_hyprland() { [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; }

stop_shell() {
    qs kill -c me-shell >/dev/null 2>&1 || true
    # Sisa instance yang tidak menjawab IPC. Pola di-anchor: pkill -f "qs -c me-shell" biasa
    # ikut membunuh proses lain yang command line-nya memuat teks itu.
    pkill -f '^(qs|quickshell) -c me-shell$' 2>/dev/null || true
}

start_shell() {
    nohup qs -c me-shell >/dev/null 2>&1 &
    disown || true
}

# --- Perintah -----------------------------------------------------------------

cmd_install() {
    banner
    local root
    root="$(repo_root)"

    install_deps
    install_fonts

    step "Repo"
    if [ "$root" = "$DATA" ]; then
        if [ -d "$DATA/.git" ]; then
            git -C "$DATA" pull --ff-only && ok "Diperbarui: $DATA"
        else
            git clone --depth 1 "$REPO_URL" "$DATA" && ok "Di-clone ke $DATA"
        fi
    else
        ok "Pakai repo lokal: $root"
    fi

    step "Symlink"
    link "$root" "$QS_LINK"
    chmod +x "$root/scripts/me-shell"
    link "$root/scripts/me-shell" "$BIN"
    case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) warn "~/.local/bin belum ada di PATH; tambahkan supaya perintah 'me-shell' bisa dipakai" ;; esac

    write_hypr_files
    setup_hyprland_conf
    setup_terminal "$root"

    step "Paket dev"
    if ask_no "Pasang juga alat developer (VS Code, PHP, Python, Node, Docker, database, Brave, Discord)?"; then
        cmd_dev
    else
        note "Bisa dipasang kapan saja: me-shell dev"
    fi

    step "Selesai"
    if in_hyprland; then
        hyprctl reload >/dev/null && ok "Hyprland di-reload"
        stop_shell
        start_shell
        ok "me-shell dinyalakan"
    else
        note "Login ke sesi Hyprland; me-shell akan jalan otomatis."
    fi
    if [ "${USER:-}" = "liveuser" ]; then
        warn "User live tidak punya password, jadi lockscreen tidak bisa di-unlock."
        warn "Jalankan 'passwd' dulu sebelum mengetes lockscreen."
    fi
    note "Perintah: me-shell update | restart | log | uninstall"
}

cmd_update() {
    local root
    root="$(repo_root)"
    step "Update ($root)"
    git -C "$root" pull --ff-only
    cmd_restart
}

cmd_restart() {
    stop_shell
    sleep 0.5
    start_shell
    ok "me-shell di-restart"
}

cmd_log() {
    mkdir -p "$STATE"
    local log
    log="$STATE/log-$(date +%Y%m%d-%H%M%S).txt"
    stop_shell
    step "Menjalankan me-shell, log disimpan ke $log (Ctrl+C untuk berhenti)"
    qs -c me-shell 2>&1 | tee "$log" || true
    note "Log: $log"
    note "Jalankan 'me-shell restart' untuk menyalakan lagi di belakang."
}

cmd_uninstall() {
    step "Uninstall"
    ask "Lanjut uninstall me-shell?" || exit 0
    stop_shell
    if [ -f "$HYPR_CONF" ]; then
        sed -i "\|^$SOURCE_LINE\$|d; /^# me-shell\$/d" "$HYPR_CONF"
        ok "Baris source dihapus dari hyprland.conf"
    fi
    # grep keluar dengan status 1 kalau tidak ada yang cocok; tanpa "|| true" set -e menghentikan uninstall
    { grep -rlF --include='*.conf' "$MARK" "$CONF/hypr" 2>/dev/null || true; } | while read -r f; do
        sed -i "s/^$MARK //" "$f"
        ok "Dikembalikan: $f"
    done
    if [ -f "$KITTY_CONF" ]; then
        sed -i '\|^include .*/assets/kitty/me-shell.conf$|d; /^# me-shell$/d' "$KITTY_CONF"
        ok "Gaya me-shell dilepas dari kitty.conf"
    fi
    for rc in "$HOME/.bashrc" "${ZDOTDIR:-$HOME}/.zshrc" "$CONF/fish/config.fish"; do
        [ -f "$rc" ] && grep -qx "# me-shell" "$rc" || continue
        sed -i '/^# me-shell$/{N;/starship init/d}' "$rc"
        ok "starship dilepas dari $rc"
    done
    rm -f "$QS_LINK" "$BIN"
    ok "Symlink dihapus"
    if ask "Hapus juga setting di $CONF/me-shell?"; then
        rm -rf "$CONF/me-shell"
        ok "Setting dihapus"
    fi
    if [ -d "$DATA" ] && ask "Hapus repo di $DATA?"; then
        rm -rf "$DATA"
        ok "Repo dihapus"
    fi
    in_hyprland && hyprctl reload >/dev/null || true
    note "Selesai. Paket yang sudah ter-install tidak dihapus."
}

usage() {
    cat <<EOF
Pemakaian: me-shell <perintah> [-y]

  install     install dependency, pasang shell, sambungkan ke Hyprland
  update      git pull lalu restart shell
  restart     matikan lalu nyalakan lagi shell
  log         jalankan shell di terminal dan simpan log (untuk lapor error)
  uninstall   lepas me-shell dari Hyprland dan hapus symlink
  dev         pasang alat developer per grup (editor, bahasa, container, database, aplikasi)

  -y          jawab "ya" untuk semua pertanyaan
EOF
}

main() {
    local cmd="${1:-help}"
    shift || true
    for a in "$@"; do
        [ "$a" = "-y" ] && YES=1
    done
    case "$cmd" in
    install) cmd_install ;;
    update) cmd_update ;;
    restart) cmd_restart ;;
    log) cmd_log ;;
    uninstall) cmd_uninstall ;;
    dev) cmd_dev ;;
    -h | --help | help) usage ;;
    *) usage; exit 1 ;;
    esac
}

main "$@"
